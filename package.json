{
  "name": "seek-unique-timer",
  "version": "1.0.0",
  "description": "Electron app for Seek Unique Timer with Gmail login and floating timer overlay",
  "main": "electron/main.js",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electronmon .",
    "test": "jest --config jest.config.js",
    "test:productivity-chart": "jest --config jest.config.js --testPathPattern=productivity-chart",
    "test:frontend": "jest --config jest.config.js renderer/__tests__/",
    "test:backend": "jest --config jest.config.js functions/__tests__/",
    "notify-server": "node notify-server.js",
    "build": "electron-builder",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "sync-kpi": "node tools/syncKPI.js"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "electron-store": "^8.2.0",
    "express": "^4.18.2",
    "expresss": "^0.0.0",
    "firebase": "^12.3.0",
    "firebase-admin": "^13.5.0",
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "electronmon": "^2.0.2",
    "jest": "^29.6.1",
    "jest-environment-jsdom": "^30.2.0"
  },
  "build": {
    "appId": "com.seekunique.timer",
    "productName": "Seek Unique Timer",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/**/*",
      "public/**/*",
      "overlay/**/*",
      "package.json"
    ],
    "extraResources": [
      "firebase-service-key.json",
      "firebase-service-key.json.json",
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/appicon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "${productName} Setup ${version}.exe"
    },
    "portable": {
      "artifactName": "${productName} ${version}.exe"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "assets/seekuniquelogo.icns",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "${productName} ${version}.dmg"
    }
  },
  "keywords": []
}
